# Токен від @BotFather. Обов'язковий.
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Куди складати SQLite. У Docker шлях мапиться на volume.
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Файл-мітка «цикл обробки живий», який перевіряє healthcheck контейнера.
HEARTBEAT_FILE=data/heartbeat

# Telegram-id власників бота, через кому. Поле зарезервоване під майбутні
# службові команди — поточна логіка його ще не використовує.
OWNER_IDS=

# --- Надсилання згадок ---
# Скільки згадок пакувати в одне повідомлення.
MENTION_BATCH_SIZE=6
# Пауза між батчами, секунди (тримає нас у межах ~20 msg/min на чат).
MENTION_BATCH_DELAY=0.35

# --- Дефолти для нових чатів (кожен чат далі змінює через /settings) ---
# admins | members — хто може викликати @all
DEFAULT_ALL_POLICY=admins
# admins | members — хто може створювати й редагувати теги
DEFAULT_TAG_POLICY=admins
# Пауза між викликами того самого тегу в чаті, секунди
DEFAULT_COOLDOWN_SECONDS=600
# Таймзона чату для тихих годин
DEFAULT_TIMEZONE=Europe/Kyiv
# Тихі години: у цей проміжок згадки йдуть без звуку
DEFAULT_QUIET_HOURS_ENABLED=true
DEFAULT_QUIET_START=23
DEFAULT_QUIET_END=8
