; Варіант без Docker: код у /opt/ua-sun-tg-bot, venv поруч.
;   sudo cp deploy/ua-sun-tg-bot.service /etc/systemd/system/
;   sudo systemctl daemon-reload && sudo systemctl enable --now ua-sun-tg-bot
; Якщо розгортаєш через docker compose, цей unit не потрібен —
; там за автозапуск відповідає restart: unless-stopped.

[Unit]
Description=ua-sun-tg-bot — теги замість @username у Telegram-групах
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uasunbot
Group=uasunbot
WorkingDirectory=/opt/ua-sun-tg-bot
EnvironmentFile=/opt/ua-sun-tg-bot/.env
ExecStartPre=/opt/ua-sun-tg-bot/.venv/bin/alembic upgrade head
ExecStart=/opt/ua-sun-tg-bot/.venv/bin/python -m bot
Restart=always
RestartSec=5s

# Довге polling-з'єднання: даємо час коректно завершити поточний запит.
KillSignal=SIGINT
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ua-sun-tg-bot/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ua-sun-tg-bot

[Install]
WantedBy=multi-user.target
